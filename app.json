{
  "expo": {
    "name": "ORBIT",
    "slug": "orbit",
    "scheme": "orbit",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "O ORBIT usa suas fotos para você escolher a imagem do perfil."
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
